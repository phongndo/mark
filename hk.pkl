amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

exclude = List(
  "target",
  "dist",
)

local architectureGlobs = List(
  "scripts/check-architecture",
  "crates/mark-tui/src/**",
  "crates/mark-diff/src/**",
  "crates/mark-cli/src/**",
)

local rustImpactGlobs = List(
  "**/*.rs",
  "Cargo.toml",
  "Cargo.lock",
  "crates/*/Cargo.toml",
  "rust-toolchain.toml",
)

local hygiene = new Mapping<String, Step | Group> {
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["private-key"] = Builtins.detect_private_key
  ["large-file"] = Builtins.check_added_large_files
  ["case-conflict"] = Builtins.check_case_conflict
  ["executable-shebang"] = Builtins.check_executables_have_shebangs
  ["symlinks"] = Builtins.check_symlinks
  ["bom"] = Builtins.byte_order_marker
  ["line-endings"] = Builtins.mixed_line_ending
  ["newlines"] = (Builtins.newlines) {
    // These files preserve the exact bytes from github-vscode-themes.
    exclude = List(
      "assets/themes/github-dark.json",
      "assets/themes/github-dark-high-contrast.json",
      "assets/themes/github-light.json",
      "assets/themes/github-light-high-contrast.json",
    )
  }
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

local fast = new Mapping<String, Step | Group> {
  ...hygiene

  ["rustfmt"] {
    glob = "**/*.rs"
    check = "rustfmt --check --edition 2024 {{files}}"
    check_list_files = "rustfmt --check --edition 2024 --files-with-diff {{files}}"
    fix = "rustfmt --edition 2024 {{files}}"
  }

  ["architecture"] {
    glob = architectureGlobs
    check = "scripts/check-architecture"
  }

  ["actionlint"] = (Builtins.actionlint) {
    check = "actionlint {{files}}"
  }

  ["taplo-lint"] {
    glob = "**/*.toml"
    env { ["RUST_LOG"] = "warn" }
    check = "taplo lint {{files}}"
  }

  ["just-format"] {
    glob = "justfile"
    check = "just --fmt --check --unstable --justfile justfile"
    fix = "just --fmt --unstable --justfile justfile"
  }
}

local full = new Mapping<String, Step | Group> {
  ["cargo-audit"] {
    profiles = List("full")
    glob = rustImpactGlobs
    check = "cargo audit --deny warnings"
    exclusive = true
  }

  ["rust-analyzer"] {
    profiles = List("full")
    glob = rustImpactGlobs
    check = "rust-analyzer diagnostics ."
    exclusive = true
  }

  ["cargo-clippy"] {
    profiles = List("full")
    glob = rustImpactGlobs
    check = "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings"
    exclusive = true
  }
}

local ci = new Mapping<String, Step | Group> {
  ["cargo-check"] {
    profiles = List("ci")
    glob = rustImpactGlobs
    check = "cargo check --workspace --all-targets --all-features --locked"
    exclusive = true
  }

  ["cargo-test"] {
    profiles = List("ci")
    glob = rustImpactGlobs
    check = "cargo test --workspace --all-targets --all-features --locked"
    exclusive = true
  }

  ["cargo-build"] {
    profiles = List("ci")
    glob = rustImpactGlobs
    check = "cargo build --workspace --all-targets --all-features --locked"
    exclusive = true
  }
}

local all = new Mapping<String, Step | Group> {
  ...fast
  ...full
  ...ci
}

// Pre-push quality gates are mandatory, not profile-gated. Hook-local
// environment variables are passed to commands after hk selects steps, so
// they cannot safely enable profiles used during selection.
local prePush = new Mapping<String, Step | Group> {
  ...fast
  // Advisory data changes independently of repository files, so audit every push.
  ["cargo-audit"] = (full["cargo-audit"]) {
    profiles = List()
    glob = List("**")
  }
  ["rust-analyzer"] = (full["rust-analyzer"]) { profiles = List() }
  ["cargo-clippy"] = (full["cargo-clippy"]) { profiles = List() }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }

  ["pre-push"] { steps = prePush }

  ["check"] { steps = all }

  ["fix"] {
    fix = true
    stash = "git"
    steps = fast
  }
}
