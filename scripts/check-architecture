#!/usr/bin/env sh
set -eu

repo_dir=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
cd "$repo_dir"

fail=0

check_absent() {
  pattern=$1
  shift
  if rg -n "$pattern" "$@" >/tmp/mark-architecture-rg.$$ 2>/dev/null; then
    cat /tmp/mark-architecture-rg.$$
    fail=1
  fi
  rm -f /tmp/mark-architecture-rg.$$
}

check_absent 'mod prelude|super::prelude|prelude::\*' crates/mark-tui/src/app crates/mark-tui/src/controls.rs crates/mark-tui/src/render crates/mark-diff/src crates/mark-cli/src
check_absent '\bEventCtx\b|EventLayer' crates/mark-tui/src
check_absent 'ctx\.app\(' crates/mark-tui/src
check_absent 'DiffApp' crates/mark-tui/src/render/compositor.rs
check_absent '&mut DiffApp' crates/mark-tui/src/render/menus crates/mark-tui/src/render/sidebar.rs crates/mark-tui/src/render/statusline crates/mark-tui/src/render/toast.rs
check_absent 'settings_write_path\(' -g '!effect.rs' -g '!options.rs' crates/mark-tui/src/app
check_absent 'persist_options_menu_draft_to_path\(' -g '!effect.rs' -g '!options.rs' crates/mark-tui/src/app
check_absent 'ThreadPoolBuilder|rayon::(join|scope|spawn)' crates -g '*.rs' -g '!**/mark-runtime/src/lib.rs'
check_absent '\.(par_iter|par_iter_mut|into_par_iter)\(' crates -g '*.rs' -g '!**/mark-diff/src/parser.rs' -g '!**/mark-tui/src/search.rs'
check_absent 'syntaxmate::(engine|grammars)' crates/mark-syntax/src -g '*.rs'
check_absent 'mark[_-]tui|ratatui' crates/mark-session
check_absent '\bDiffApp\b|\bUiRow\b' crates/mark-session/src
check_absent 'ReviewPersistence|MARK_STATE_HOME|mark/reviews' crates/mark-tui/src crates/mark-cli/src

for removed_path in \
  assets/grammars \
  crates/mark-syntax/src/engine \
  crates/mark-syntax/src/grammars \
  crates/mark-syntax/tests/fixtures \
  crates/mark-tui/src/review/persistence.rs \
  tools/golden-oracle
do
  if [ -e "$removed_path" ]; then
    echo "$removed_path: duplicated Syntaxmate implementation or assets must not return" >&2
    fail=1
  fi
done

python3 - <<'PY'
from pathlib import Path
import json
import subprocess
import sys

# Budgets are intentionally local to architectural seam files. Large data tables,
# parser tests, and rendering algorithms may have their own split plans, but these
# files should stay small enough to make boundary violations obvious in review.
budgets = {
    'crates/mark-tui/src/app.rs': 120,
    'crates/mark-tui/src/app/input.rs': 260,
    'crates/mark-tui/src/app/input/layers.rs': 520,
    'crates/mark-tui/src/app/input/layers/tests.rs': 240,
    'crates/mark-tui/src/app/input/event_context.rs': 240,
    'crates/mark-tui/src/app/controllers.rs': 20,
    'crates/mark-tui/src/app/controllers/filter.rs': 80,
    'crates/mark-tui/src/app/controllers/menu.rs': 140,
    'crates/mark-tui/src/app/controllers/navigation.rs': 100,
    'crates/mark-tui/src/app/diff_load.rs': 180,
    'crates/mark-tui/src/app/diff_load/cache.rs': 180,
    'crates/mark-tui/src/app/diff_load/prefetch.rs': 180,
    'crates/mark-tui/src/app/diff_load/review.rs': 120,
    'crates/mark-tui/src/app/effect.rs': 180,
    'crates/mark-tui/src/app/mouse.rs': 340,
    'crates/mark-tui/src/app/mouse/event_context.rs': 230,
    'crates/mark-tui/src/app/navigation.rs': 20,
    'crates/mark-tui/src/render/compositor.rs': 180,
    'crates/mark-tui/src/render/diff.rs': 520,
    'crates/mark-tui/src/render/diff/context.rs': 360,
    'crates/mark-tui/src/render/diff/unified.rs': 260,
    'crates/mark-tui/src/render/grep.rs': 40,
    'crates/mark-tui/src/render/grep/highlight.rs': 180,
    'crates/mark-tui/src/render/grep/cursor.rs': 120,
    'crates/mark-tui/src/render/grep/target.rs': 340,
    'crates/mark-tui/src/render/grep/types.rs': 60,
    'crates/mark-tui/src/render/headers.rs': 40,
    'crates/mark-tui/src/render/headers/delta.rs': 140,
    'crates/mark-tui/src/render/headers/file.rs': 100,
    'crates/mark-tui/src/render/headers/fit.rs': 320,
    'crates/mark-tui/src/render/headers/hunk.rs': 200,
    'crates/mark-tui/src/render/headers/types.rs': 80,
    'crates/mark-tui/src/render/statusline.rs': 40,
    'crates/mark-tui/src/render/statusline/error_log.rs': 140,
    'crates/mark-tui/src/render/statusline/filter_bar.rs': 300,
    'crates/mark-tui/src/render/statusline/header.rs': 300,
    'crates/mark-diff/src/tests.rs': 120,
    'crates/mark-diff/src/tests/branch_review.rs': 220,
    'crates/mark-diff/src/tests/difftool.rs': 320,
    'crates/mark-diff/src/tests/parser.rs': 320,
    'crates/mark-diff/src/tests/patch_sources.rs': 180,
    'crates/mark-diff/src/tests/range.rs': 280,
    'crates/mark-diff/src/tests/repo_infra.rs': 120,
    'crates/mark-diff/src/tests/show.rs': 260,
    'crates/mark-diff/src/tests/worktree.rs': 220,
    'crates/mark-cli/src/syntax.rs': 140,
    'crates/mark-cli/src/syntax/commands.rs': 160,
    'crates/mark-cli/src/syntax/options.rs': 160,
    'crates/mark-cli/src/syntax/output.rs': 180,
    'crates/mark-cli/src/syntax/table.rs': 360,
    'crates/mark-cli/src/pager.rs': 100,
    'crates/mark-cli/src/pager/tests.rs': 100,
    'crates/mark-cli/src/pager/tests/patch.rs': 220,
    'crates/mark-cli/src/pager/tests/routing.rs': 180,
    'crates/mark-cli/src/pager/tests/streaming.rs': 220,
    'crates/mark-cli/src/pager/tests/terminal.rs': 80,
}

failed = False

metadata = json.loads(
    subprocess.check_output(
        ['cargo', 'metadata', '--locked', '--format-version', '1'],
        text=True,
    )
)
syntaxmate_packages = [
    package for package in metadata['packages'] if package['name'] == 'syntaxmate'
]
registry_source = 'registry+https://github.com/rust-lang/crates.io-index'
if len(syntaxmate_packages) != 1:
    print(
        f'expected one resolved Syntaxmate package, found {len(syntaxmate_packages)}',
        file=sys.stderr,
    )
    failed = True
elif syntaxmate_packages[0].get('source') != registry_source:
    print(
        'Syntaxmate must resolve from crates.io without a path, Git, or patch override',
        file=sys.stderr,
    )
    failed = True

mark_syntax = next(
    (package for package in metadata['packages'] if package['name'] == 'mark-syntax'),
    None,
)
mark_session = next(
    (package for package in metadata['packages'] if package['name'] == 'mark-session'),
    None,
)
if mark_session is None:
    print('mark-session workspace crate is missing', file=sys.stderr)
    failed = True
else:
    forbidden = {'mark-tui', 'ratatui', 'mark-diff'}
    present = sorted(
        dependency['name']
        for dependency in mark_session['dependencies']
        if dependency['name'] in forbidden
    )
    if present:
        print(
            f'mark-session has forbidden UI/diff dependencies: {", ".join(present)}',
            file=sys.stderr,
        )
        failed = True

syntaxmate_dependencies = [] if mark_syntax is None else [
    dependency
    for dependency in mark_syntax['dependencies']
    if dependency['name'] == 'syntaxmate'
]
if len(syntaxmate_dependencies) != 1 or syntaxmate_dependencies[0].get('source') != registry_source:
    print('mark-syntax must declare Syntaxmate as a crates.io dependency', file=sys.stderr)
    failed = True

for path, max_lines in budgets.items():
    lines = Path(path).read_text().count('\n') + 1
    if lines > max_lines:
        print(f'{path}: {lines} lines exceeds architecture budget {max_lines}', file=sys.stderr)
        failed = True

if failed:
    sys.exit(1)
PY

if [ "$fail" -ne 0 ]; then
  exit 1
fi

echo "architecture checks passed"
