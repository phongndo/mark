#!/usr/bin/env python3
"""Exercise Pi handing over its terminal for annotations and receiving plain Markdown locally.

Run inside the development shell after building mark-cli. Python uses only its
standard library; --pi and --mark accept explicit installed/built executables.
The message check uses a local mock provider, not a model service.
"""

import argparse
import fcntl
import json
import os
from pathlib import Path
import pty
import re
import select
import shutil
import signal
import struct
import subprocess
import tempfile
import termios
import time


ROOT = Path(__file__).resolve().parents[1]
ANSI = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b\[[0-?]*[ -/]*[@-~]")
MOCK_PROVIDER = r'''
import { createAssistantMessageEventStream } from "@earendil-works/pi-ai";
import { appendFileSync } from "node:fs";
export default function (pi) {
  pi.on("message_start", event => {
    if (event.message.role === "user") appendFileSync(process.env.MARK_TEST_MESSAGES, JSON.stringify(event.message) + "\n");
  });
  pi.registerProvider("mark-test-local", {
    baseUrl: "http://127.0.0.1", api: "mark-test-local-api", apiKey: "local-test-only",
    models: [{ id: "receipt", name: "Local receipt test", reasoning: false,
      input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
      contextWindow: 32768, maxTokens: 1024 }],
    streamSimple(model) {
      const stream = createAssistantMessageEventStream();
      const message = { role: "assistant", content: [], api: "mark-test-local-api",
        provider: "mark-test-local", model: model.id, timestamp: Date.now(), stopReason: "stop",
        usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,
          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } } };
      queueMicrotask(() => {
        stream.push({ type: "start", partial: message });
        message.content.push({ type: "text", text: "Local receipt accepted." });
        stream.push({ type: "text_start", contentIndex: 0, partial: message });
        stream.push({ type: "text_delta", contentIndex: 0, delta: "Local receipt accepted.", partial: message });
        stream.push({ type: "text_end", contentIndex: 0, content: "Local receipt accepted.", partial: message });
        stream.push({ type: "done", reason: "stop", message });
        stream.end();
      });
      return stream;
    },
  });
}
'''


class Terminal:
    def __init__(self, command, cwd, env):
        self.master, slave = pty.openpty()
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 30, 120, 0, 0))

        def own_terminal():
            os.setsid()
            fcntl.ioctl(0, termios.TIOCSCTTY, 0)

        self.process = subprocess.Popen(command, cwd=cwd, env=env, stdin=slave,
                                        stdout=slave, stderr=slave, preexec_fn=own_terminal)
        os.close(slave)
        self.output = ""

    def pump(self, timeout=0.1):
        if select.select([self.master], [], [], timeout)[0]:
            try:
                self.output += os.read(self.master, 65536).decode("utf-8", "replace")
            except OSError:
                pass

    def wait(self, predicate, description, timeout=12):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            self.pump()
            if predicate():
                return
            if self.process.poll() is not None:
                break
        raise AssertionError(f"Timed out waiting for {description}:\n{ANSI.sub('', self.output)[-2500:]}")

    def contains(self, text, after=0):
        return text in ANSI.sub("", self.output[after:])

    def send(self, text):
        start = len(self.output)
        os.write(self.master, text.encode())
        return start

    def close(self):
        if self.process.poll() is None:
            self.send("\x04")
            deadline = time.monotonic() + 1
            while self.process.poll() is None and time.monotonic() < deadline:
                self.pump()
        for sig in (signal.SIGTERM, signal.SIGKILL):
            if self.process.poll() is not None:
                break
            os.killpg(self.process.pid, sig)
            deadline = time.monotonic() + 3
            while self.process.poll() is None and time.monotonic() < deadline:
                self.pump()
        if self.process.poll() is None:
            raise AssertionError("Pi did not exit after SIGKILL")
        os.close(self.master)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pi", default=shutil.which("pi"))
    parser.add_argument("--mark", default=str(ROOT / "target/debug/mark"))
    parser.add_argument("--package-dir", type=Path)
    args = parser.parse_args()
    if not args.pi:
        parser.error("Pi is unavailable; pass --pi /absolute/path/to/pi")
    mark = str(Path(args.mark).resolve())
    if not Path(mark).is_file():
        parser.error("Build Mark first: nix develop -c cargo build -p mark-cli --locked")
    with tempfile.TemporaryDirectory(prefix="mark-pi-terminal-") as temporary:
        task = Path(temporary).resolve()
        repository = task / "repository"
        repository.mkdir()
        env = {key: os.environ[key] for key in ("PATH", "HOME", "USER", "SHELL", "LANG", "LC_ALL", "COLORTERM") if key in os.environ}
        env.update(TERM="xterm-256color", PI_OFFLINE="1", MARK_BIN=mark,
                   PI_CODING_AGENT_DIR=str(task / "pi"), XDG_STATE_HOME=str(task / "state"),
                   XDG_CONFIG_HOME=str(task / "config"), XDG_DATA_HOME=str(task / "data"),
                   XDG_CACHE_HOME=str(task / "cache"),
                   MARK_TEST_MESSAGES=str(task / "messages"))
        package = args.package_dir
        if package is None:
            package = task / "package"
            subprocess.run([mark, "integration", "export", "--agent", "pi", "--output", str(package)], env=env, check=True, capture_output=True)
        extension = str((package / "index.js").resolve())
        provider = task / "local-provider.js"
        provider.write_text(MOCK_PROVIDER)
        def git(*arguments):
            subprocess.run(["git", *arguments], cwd=repository, env=env, check=True, capture_output=True)
        git("init", "--quiet")
        git("config", "user.name", "Mark terminal test")
        git("config", "user.email", "mark-test@example.invalid")
        (repository / "example.txt").write_text("before\n")
        git("add", "example.txt")
        git("commit", "--quiet", "-m", "baseline")
        (repository / "example.txt").write_text("after\n")
        command = [args.pi, "--offline", "--no-session", "--no-context-files", "--no-skills", "--no-extensions",
                   "-e", extension, "-e", str(provider), "--provider", "mark-test-local", "--model", "receipt", "--api-key", "local-test-only"]
        terminal = Terminal(command, repository, env)
        try:
            terminal.wait(lambda: terminal.contains("commands"), "Pi startup")
            start = terminal.send("/mark\r")
            terminal.wait(lambda: terminal.contains("Q return all marks", start), "terminal handoff")
            assert not (task / "messages").exists(), "Opening must not send feedback"
            # Enter annotates the focused code line.
            terminal.send("\r")
            terminal.wait(lambda: terminal.contains("[✓]", start), "annotation editor")
            terminal.send("What does this mean?")
            start = terminal.send("Q")
            terminal.wait(lambda: terminal.contains("example.txt:1", start), "annotations in the Pi input")
            deadline = time.monotonic() + 0.5
            while time.monotonic() < deadline:
                terminal.pump()
            assert not (task / "messages").exists(), "Submitting annotations must only fill the draft"
            assert not terminal.contains("Local receipt accepted."), "Submitting annotations must not start an agent turn"
            terminal.send(" Please explain.\r")
            terminal.wait(lambda: terminal.contains("Local receipt accepted."), "manual Enter starts the local response")
            messages = [json.loads(line) for line in (task / "messages").read_text().splitlines()]
            assert len(messages) == 1, messages
            content = messages[0]["content"]
            text = content if isinstance(content, str) else "".join(part.get("text", "") for part in content if part["type"] == "text")
            assert text == "- `example.txt:1` — What does this mean? Please explain.", text
            start = terminal.send("/mark\r")
            terminal.wait(lambda: terminal.contains("Q return all marks", start), "fresh terminal review")
            # With no notes, Q immediately returns an empty draft. Reopening
            # proves that it exited and did not restore the old annotation.
            terminal.send("Q")
            deadline = time.monotonic() + 0.3
            while time.monotonic() < deadline:
                terminal.pump()
            start = terminal.send("/mark\r")
            terminal.wait(lambda: terminal.contains("Q return all marks", start), "reopen after empty Shift-Q")
            terminal.send("q")
            terminal.pump(0.2)
            assert len((task / "messages").read_text().splitlines()) == 1
            assert not (task / "state/mark/reviews").exists(), "Annotation sessions must not write history"
        finally:
            terminal.close()
    print("Pi terminal check passed: Shift-Q instantly fills the draft, only manual Enter sends, fresh invocations, no review history.")


if __name__ == "__main__":
    main()
