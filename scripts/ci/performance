#!/usr/bin/env sh
set -eux

mode="${1:-smoke}"
case "$mode" in
  smoke | extended) ;;
  *)
    echo "usage: scripts/ci/performance [smoke|extended]" >&2
    exit 2
    ;;
esac

tmp_root="${RUNNER_TEMP:-${TMPDIR:-/tmp}}"
work_dir="$(mktemp -d "$tmp_root/mark-ci-performance.XXXXXX")"
trap 'rm -rf "$work_dir"' EXIT INT TERM

if [ "$mode" = extended ]; then
  cargo build -p mark-cli --release --locked
  scripts/check-startup target/release/mark 2.0
fi

cargo run -p mark-bench --locked -- fixtures \
  --out "$work_dir/many-small" \
  --scenario many-small-files \
  --force
cargo run -p mark-bench --locked -- measure \
  --fixtures "$work_dir/many-small" \
  --scenario many-small-files \
  --json

cargo run -p mark-bench --locked -- fixtures \
  --out "$work_dir/syntax-rust" \
  --scenario syntax-many-small-rust \
  --force
cargo run -p mark-bench --locked -- measure \
  --fixtures "$work_dir/syntax-rust" \
  --scenario syntax-many-small-rust \
  --syntax-language rust \
  --max-scroll-steps 20 \
  --json > "$work_dir/syntax-rust.json"
cat "$work_dir/syntax-rust.json"
python3 - "$work_dir/syntax-rust.json" <<'PY'
import json
import sys

report = json.load(open(sys.argv[1], encoding="utf-8"))
syntax_runs = [run for run in report["runs"] if run["tui"]["syntax_enabled"]]
if len(syntax_runs) != 1:
    raise SystemExit(f"expected one syntax run, found {len(syntax_runs)}")
metrics = syntax_runs[0]["tui"]["syntax"]
if metrics["jobs_completed"] <= 0 or metrics["jobs_failed"] != 0:
    raise SystemExit(f"syntax regression: {metrics}")
PY

cargo run -p mark-bench --locked -- fixtures \
  --out "$work_dir/mega-diff" \
  --scenario mega-diff-1m \
  --force
if [ "$mode" = extended ]; then
  cargo run -p mark-bench --locked -- measure \
    --fixtures "$work_dir/mega-diff" \
    --scenario mega-diff-1m \
    --max-scroll-steps 20 \
    --assert-max-rss-ratio 3.0 \
    --json
else
  cargo run -p mark-bench --locked -- measure \
    --fixtures "$work_dir/mega-diff" \
    --scenario mega-diff-1m \
    --max-scroll-steps 20 \
    --json
fi
